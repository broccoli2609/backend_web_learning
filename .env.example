# Sao chép file này thành .env rồi sửa giá trị.
# Chạy kèm cấu hình: node --env-file=.env server/server.js
# File .env KHÔNG được commit — xem .gitignore.

# Môi trường: development | production
NODE_ENV=development

# Cổng và địa chỉ server lắng nghe
PORT=3000
HOST=0.0.0.0

# Origin được phép gọi API, ngăn cách bằng dấu phẩy.
# Ở production phải khai báo rõ, không được để trống.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Nơi lưu tiến độ. Mặc định là server/storage.
# STORAGE_DIR=/var/lib/xuong-backend

# Mức log: debug | info | warn | error
LOG_LEVEL=debug
